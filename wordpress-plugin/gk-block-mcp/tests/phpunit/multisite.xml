<?xml version="1.0"?>
<phpunit bootstrap="../bootstrap-wp.php" colors="true">
    <php>
        <!-- BlockApiTestCase is the shared abstract base for every block-aware test. -->
        <const name="GK_BLOCK_MCP_TEST_BASE_PATH" value="BlockApiTestCase.php"/>
        <!-- Tell the WordPress test bootstrap to initialise a multisite install. -->
        <const name="WP_TESTS_MULTISITE" value="1"/>
    </php>
    <testsuites>
        <testsuite name="GK Block API (multisite)">
            <directory>../Block</directory>
            <directory>../Post</directory>
            <directory>../REST</directory>
            <directory>../Media</directory>
            <directory>../Preferences</directory>
            <directory>../Integrations</directory>
            <directory>../Security</directory>
            <directory>../Stress</directory>
            <directory>../Connect</directory>
        </testsuite>
    </testsuites>
    <!--
        This config runs ONLY the ms-required group — the tests whose contract is
        multisite-specific. The rest of the suite runs single-site (tests/phpunit.xml)
        where it is exhaustively covered. Restricting to ms-required also keeps
        process-isolated tests (@runInSeparateProcess) out of the multisite run:
        a child process re-installing the multisite environment over the parent's
        open SQLite database deadlocks.
    -->
    <groups>
        <include>
            <group>ms-required</group>
        </include>
    </groups>
</phpunit>
