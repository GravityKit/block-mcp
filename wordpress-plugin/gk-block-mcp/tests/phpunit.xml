<?xml version="1.0"?>
<phpunit bootstrap="bootstrap-wp.php" colors="true">
    <php>
        <!-- BlockApiTestCase is the shared abstract base for every block-aware test. -->
        <const name="GK_BLOCK_MCP_TEST_BASE_PATH" value="BlockApiTestCase.php"/>
    </php>
    <testsuites>
        <testsuite name="GK Block API">
            <directory>Block</directory>
            <directory>Post</directory>
            <directory>REST</directory>
            <directory>Media</directory>
            <directory>Preferences</directory>
            <directory>Instructions</directory>
            <directory>Integrations</directory>
            <directory>Security</directory>
            <directory>Stress</directory>
            <directory>Connect</directory>
            <directory>Abilities</directory>
        </testsuite>
    </testsuites>
    <!--
        Tests in the ms-required group need a multisite install and self-skip on
        single-site. Exclude them here so the single-site run reports zero skips;
        they run under tests/phpunit/multisite.xml (composer test:multisite, and
        the ms-required slice appended to composer test).

        Tests in the yoast group require a loaded Yoast SEO plugin, which only
        the dedicated tests/phpunit/yoast.xml run provides (it sets GK_LOAD_YOAST
        so the bootstrap loads Yoast). Exclude them here so this run never loads
        Yoast — keeping its DB migrations and wp_is_block_theme() call out of the
        general suite's process-isolated children.
    -->
    <groups>
        <exclude>
            <group>ms-required</group>
            <group>yoast</group>
            <group>mcp-adapter</group>
        </exclude>
    </groups>
</phpunit>
