parameters:
	# Analyze as PHP 8.2 (the production/runtime version) so PHP 8 issues —
	# type errors that became fatal, the 8.2 dynamic-property deprecation,
	# wrong argument counts — surface here rather than at runtime. Language-level
	# version compatibility down to the 7.4 floor is covered separately by
	# PHPCompatibilityWP in .phpcs.xml.dist (composer lint).
	phpVersion: 80200

	level: 5

	paths:
		- includes
		- gk-block-mcp.php
		- uninstall.php

	# Defines the plugin's runtime constants (GK_BLOCK_MCP_VERSION, ABSPATH, …).
	bootstrapFiles:
		- phpstan-bootstrap.php

	# These constants exist but their VALUE varies per environment, so the
	# analyzer must not infer `WP_DEBUG && …` as always-true/false from the
	# placeholder bootstrap value.
	dynamicConstantNames:
		- WP_DEBUG
		- WP_DEBUG_LOG
		- WP_CLI

	# WordPress core function/class/constant symbols so wp_*() calls resolve.
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

	excludePaths:
		- tests/*
		- vendor/*
		- vendor_prefixed/*
		- dist/*

	ignoreErrors:
		# Dynamic WordPress-core admin includes — `require_once ABSPATH . 'wp-admin/includes/*.php'`
		# (file/media/image for uploads; user/ms for agent teardown). Each is guarded
		# at runtime (e.g. is_dir( ABSPATH . 'wp-admin' )); the literal path can't be
		# resolved statically against the placeholder ABSPATH in phpstan-bootstrap.php.
		- identifier: requireOnce.fileNotFound

		# GravityKit Foundation is Strauss-prefixed into vendor_prefixed/ at
		# `composer install` time, so its classes don't exist when PHPStan
		# analyzes the bootstrap. The two references are the documented UI-less
		# entry points (should_load gate + Core::register).
		- '#Function GravityKit\\BlockMCP\\Foundation\\should_load not found\.#'
		- '#Call to static method register\(\) on an unknown class GravityKit\\BlockMCP\\Foundation\\Core\.#'

	treatPhpDocTypesAsCertain: false
