<?xml version="1.0"?>
<ruleset name="GK Block API">
	<description>WordPress + PHPCompatibility coding standards for the gk-block-api plugin.</description>

	<!-- Default scan target when phpcs is invoked without a path. -->
	<file>.</file>

	<!-- Don't scan dependency trees, build artefacts, generated files, or
	     the test directory (tests live by their own conventions — assert
	     hostile input, long fixture strings, etc.). -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/scripts/*</exclude-pattern>
	<!-- Static-analysis tooling (defines placeholder WP constants for PHPStan;
	     not plugin runtime code, so the global-prefix rule doesn't apply). -->
	<exclude-pattern>*/phpstan-bootstrap.php</exclude-pattern>

	<!-- CLI defaults. -->
	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/><!-- short summary + progress -->

	<!-- ── Standards ──────────────────────────────────────────────────── -->

	<!-- WordPress-Extra includes WordPress-Core plus best-practice sniffs
	     (escaping, nonce, capability checks, performance, etc.). -->
	<rule ref="WordPress-Extra"/>

	<!-- WordPress-Docs enforces docblock structure on classes / methods /
	     hooks per the Core Handbook conventions. -->
	<rule ref="WordPress-Docs"/>

	<!-- PHP version compatibility floor matches composer.json's
	     "php": ">=7.4". Anything that won't run on 7.4 surfaces here
	     rather than at deploy time. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- ── Project-specific rule config ───────────────────────────────── -->

	<!-- Recognized text domain. Strings tagged with any other (or no)
	     domain trip WordPress.WP.I18n. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gk-block-api"/>
			</property>
		</properties>
	</rule>

	<!-- Allowed global prefixes for functions, constants, options, hooks,
	     and globals. Anything outside this set trips
	     WordPress.NamingConventions.PrefixAllGlobals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="gk_block_api"/>
				<element value="GK_BLOCK_API"/>
				<element value="GravityKit\BlockAPI"/>
			</property>
		</properties>
	</rule>

	<!-- Documented minimum WP version — surfaces wp_*() functions that
	     don't exist on the floor. -->
	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
