<?xml version="1.0"?>
<phpunit bootstrap="../bootstrap-wp.php" colors="true">
    <php>
        <!-- BlockApiTestCase is the shared abstract base for every block-aware test. -->
        <const name="GK_BLOCK_API_TEST_BASE_PATH" value="BlockApiTestCase.php"/>
        <!-- Tell the bootstrap to load Yoast SEO for this run only. The general
             single-site config (tests/phpunit.xml) leaves this unset so Yoast
             never loads there. An env var (not a const) is used so the value
             survives into @runInSeparateProcess children via process env. -->
        <env name="GK_LOAD_YOAST" value="1"/>
    </php>
    <testsuites>
        <testsuite name="GK Block API (Yoast)">
            <directory>../Block</directory>
            <directory>../Post</directory>
            <directory>../REST</directory>
            <directory>../Media</directory>
            <directory>../Preferences</directory>
            <directory>../Integrations</directory>
            <directory>../Security</directory>
            <directory>../Stress</directory>
            <directory>../Connect</directory>
        </testsuite>
    </testsuites>
    <!--
        This config runs ONLY the yoast group — the tests whose contract needs a
        loaded Yoast SEO plugin. It is the one run where the bootstrap loads
        Yoast (via GK_LOAD_YOAST above). The rest of the suite runs Yoast-free
        under tests/phpunit.xml. Yoast's migrations emit CREATE INDEX statements
        the SQLite drop-in cannot run; the resulting print_error output is
        non-fatal noise here and does not affect these in-process assertions.
    -->
    <groups>
        <include>
            <group>yoast</group>
        </include>
    </groups>
</phpunit>
