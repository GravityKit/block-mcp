<?xml version="1.0"?>
<!--
    convertNoticesToExceptions=false: WordPress core/dependencies legitimately
    emit PHP notices in the test harness (e.g. WP 6.8+ flags wp_is_block_theme()
    via _doing_it_wrong when $wp_theme_directories is empty during the
    separate-process re-bootstrap — not a gk-block-api call). Under CI's
    error_reporting=E_ALL those notices would otherwise become test failures.
    Errors, warnings, and deprecations are still converted, so real problems and
    our own code's notices (caught by phpcs) still surface.
-->
<phpunit bootstrap="bootstrap-wp.php" colors="true" convertNoticesToExceptions="false">
    <php>
        <!-- BlockApiTestCase is the shared abstract base for every block-aware test. -->
        <const name="GK_BLOCK_API_TEST_BASE_PATH" value="BlockApiTestCase.php"/>
    </php>
    <testsuites>
        <testsuite name="GK Block API">
            <directory>Block</directory>
            <directory>Post</directory>
            <directory>REST</directory>
            <directory>Media</directory>
            <directory>Preferences</directory>
            <directory>Integrations</directory>
            <directory>Security</directory>
            <directory>Stress</directory>
            <directory>Connect</directory>
        </testsuite>
    </testsuites>
    <!--
        Tests in the ms-required group need a multisite install and self-skip on
        single-site. Exclude them here so the single-site run reports zero skips;
        they run under tests/phpunit/multisite.xml (composer test:multisite, and
        the ms-required slice appended to composer test).
    -->
    <groups>
        <exclude>
            <group>ms-required</group>
        </exclude>
    </groups>
</phpunit>
