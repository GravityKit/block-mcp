# Files and directories excluded from the WP.org plugin zip.
# Single source of truth — read by both `wp dist-archive` and the
# build-plugin-zip.yml GitHub Actions workflow (via rsync --exclude-from).
# Keep gitignore-style: bare names match anywhere in the tree, trailing
# slashes match directories only.

.git
.github
.gitignore
.gitattributes
.distignore
.editorconfig
.phpcs.xml
.phpunit.cache
.phpunit.result.cache
node_modules
tests
vendor
phpunit.xml
phpunit.xml.dist
composer.json
composer.lock
package.json
package-lock.json
README.md
CHANGELOG.md
*.dist
*.lock
.DS_Store
Thumbs.db
.vscode
.idea
*.log
