# Files and directories excluded from the WP.org plugin zip.
# Single source of truth — read by both `wp dist-archive` and the
# build-plugin-zip.yml GitHub Actions workflow (via rsync --exclude-from).
# Keep gitignore-style: bare names match anywhere in the tree, trailing
# slashes match directories only.

.git
.github
.gitignore
.gitattributes
.distignore
.editorconfig
.phpcs.xml
.phpunit.cache
.phpunit.result.cache
node_modules
scripts
tests
# `vendor` ships nothing — the plugin autoloads its own classes by hand and
# its only runtime dependency (GravityKit Foundation) is Strauss-prefixed into
# `vendor_prefixed/`, which IS shipped (it is not listed here). The Strauss
# binary + its post-install helper are build-time only and excluded below.
vendor
strauss.phar
composer_post_update_install.sh
phpunit.xml
phpunit.xml.dist
composer.json
composer.lock
package.json
package-lock.json
README.md
CHANGELOG.md
*.dist
*.lock
.DS_Store
Thumbs.db
.vscode
.idea
*.log
