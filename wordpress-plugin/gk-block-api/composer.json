{
    "name": "gravitykit/gk-block-api",
    "description": "GravityKit Block API — WordPress plugin exposing block-level REST endpoints.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "composer/installers": "^2.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "doctrine/instantiator": "^1.5",
        "php-stubs/wordpress-stubs": "^6.7",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "roots/wordpress": "^6.7",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.0",
        "wp-phpunit/wp-phpunit": "^6.7",
        "wpackagist-plugin/wordpress-seo": ">=23.0",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/WordPress/sqlite-database-integration"
        },
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "scripts": {
        "post-install-cmd": [
            "@install-sqlite-dropin",
            "@refresh-core-blocks-if-missing"
        ],
        "post-update-cmd": [
            "@install-sqlite-dropin",
            "@refresh-core-blocks-if-missing"
        ],
        "install-sqlite-dropin": "php tests/install-sqlite-dropin.php",
        "refresh-core-blocks": "bash scripts/refresh-core-blocks.sh",
        "refresh-core-blocks-if-missing": "php scripts/ensure-core-blocks.php",
        "test": [
            "@refresh-core-blocks-if-missing",
            "phpunit -c tests/phpunit.xml",
            "phpunit -c tests/phpunit/yoast.xml",
            "phpunit -c tests/phpunit/multisite.xml"
        ],
        "test:yoast": [
            "@refresh-core-blocks-if-missing",
            "phpunit -c tests/phpunit/yoast.xml"
        ],
        "test:multisite": [
            "@refresh-core-blocks-if-missing",
            "phpunit -c tests/phpunit/multisite.xml"
        ],
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyze": "phpstan analyse",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "roots/wordpress-core-installer": true,
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress/wordpress",
        "installer-paths": {
            "vendor/wordpress/wordpress/wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    }
}
