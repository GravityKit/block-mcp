{
    "name": "gravitykit/gk-block-api",
    "description": "GravityKit Block API — WordPress plugin exposing block-level REST endpoints.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "composer/installers": "^2.2",
        "phpunit/phpunit": "^9.6",
        "roots/wordpress": "^6.7",
        "wp-phpunit/wp-phpunit": "^6.7",
        "wpackagist-plugin/wordpress-seo": ">=23.0",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/WordPress/sqlite-database-integration"
        },
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "scripts": {
        "post-install-cmd": [
            "@install-sqlite-dropin"
        ],
        "post-update-cmd": [
            "@install-sqlite-dropin"
        ],
        "install-sqlite-dropin": "php tests/install-sqlite-dropin.php",
        "test": "phpunit -c tests/phpunit.xml"
    },
    "config": {
        "allow-plugins": {
            "roots/wordpress-core-installer": true,
            "composer/installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress/wordpress",
        "installer-paths": {
            "vendor/wordpress/wordpress/wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    }
}
